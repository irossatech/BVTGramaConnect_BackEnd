# Managed by BVT Grama Connect deploy/setup.sh. Edit the template, not this file.
[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled  = true
port     = @SSH_PORT@
backend  = systemd

# No Nginx jail: the Nginx rate limits it acted on were removed on 2026-11-20 (lead's decision).
