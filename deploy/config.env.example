# BVT Grama Connect server settings, read by deploy/setup.sh and the other scripts.
# Copy this file, edit it, then run:  sudo bash deploy/setup.sh /path/to/config.env
# setup.sh keeps a copy at /etc/gramaconnect/deploy.env for later runs.
# Plain KEY=value lines; quote values that contain spaces.

# --- Site ----------------------------------------------------------------------
DOMAIN=gramaconnect.example.in
# More names for the same site, space separated. Each must point at this server.
EXTRA_DOMAINS="www.gramaconnect.example.in"
# Let's Encrypt account and expiry notices.
ADMIN_EMAIL=ops@example.in
# 1 = test certificates from Let's Encrypt staging (not trusted by browsers).
CERTBOT_STAGING=0

# --- Server user and paths -------------------------------------------------------
APP_USER=deploy
APP_ROOT=/srv/gramaconnect
SSH_PORT=22
# 1 = disable SSH passwords and root login. Applied only when APP_USER already
# has a key in ~/.ssh/authorized_keys (setup copies root's keys if it has none).
HARDEN_SSH=1
# 1 = APP_USER may sudo without a password (the SSH key is the credential).
# 0 = set a password with "passwd deploy" before running setup.
SUDO_NOPASSWD=1

# --- Database --------------------------------------------------------------------
# mysql (MySQL 8, utf8mb4) or postgresql
DB_ENGINE=mysql
DB_NAME=grama
DB_USER=grama
# The password is generated once and kept in /etc/gramaconnect/db.password.

# --- Code ------------------------------------------------------------------------
GIT_BRANCH=main
REPO_BACKEND=https://github.com/irossatech/BVTGramaConnect_BackEnd.git
# Website (/) and Super Admin console (/console/): one repo, one build.
REPO_WEB=https://github.com/irossatech/BVTGramaConnect.git
# The mobile app is built on a developer machine, not on the server.
REPO_MOBILE=https://github.com/irossatech/BVTGramaConnect_Mobile.git
# For private repos use SSH deploy keys; see deploy/RUNBOOK.md, "Private repositories".
# API base URL baked into the web parts' build.
WEB_API_BASE=/api/v1
# Extra script sources for the web pages' Content-Security-Policy, space separated.
# Leave empty when the web parts load React from their own vendor/ folder.
CSP_SCRIPT_EXTRA=

# --- Logins ------------------------------------------------------------------------
# Officials log in with username and password. Admins set or generate temporary
# passwords in the app or console; nothing is emailed, so no SMTP is needed.
# Console sessions end after this many idle minutes.
CONSOLE_SESSION_IDLE_MINUTES=30

# --- Backups ---------------------------------------------------------------------
# Where nightly encrypted backups are copied. Replace the placeholder with one of:
#   rclone:REMOTE:PATH        an rclone remote set up with "sudo rclone config"
#   rsync:USER@HOST:/PATH     a server reachable with root's SSH key
#   local:/PATH               a mounted disk
BACKUP_TARGET="[BACKUP TARGET]"
# Generated once if missing. Keep an offline copy: without it no backup can be restored.
BACKUP_PASSPHRASE_FILE=/etc/gramaconnect/backup.passphrase
BACKUP_RETENTION_DAYS=14

# --- Django admin --------------------------------------------------------------
# Office IP addresses or ranges that may open /django-admin/, space separated,
# for example "203.0.113.10 198.51.100.0/24". Empty: Django admin is blocked for
# everyone (Nginx answers 403). The console at /console/ is not affected.
# Re-run setup.sh after changing it.
OFFICE_IPS=

# --- Checks ----------------------------------------------------------------------
# 1 (default) = deploy.sh stops before migrating when "manage.py check --deploy" reports any security
# warning. 0 = it only warns (an emergency deploy).
STRICT_CHECKS=1
# 1 (default) = deploy.sh stops before migrating when pip-audit finds a known vulnerability in
# requirements.txt. 0 = skip the check (an emergency deploy). Needs internet access, as pip does.
AUDIT_DEPENDENCIES=1
