# Copy to .env and fill in. Real environment variables win over this file.
# Local development needs no .env at all: the defaults run on SQLite.

# All settings are in grama/settings.py. DEBUG picks the mode:
#   True or unset: development (SQLite, Django serves the web parts, cookies over plain http).
#   False: production (secure cookies, HSTS, key check; the "Required on the server" lines below).
# Every server, qa included, runs with DEBUG=False. Development mode refuses to start when
# ALLOWED_HOSTS names a domain (a server whose DEBUG=False line went missing); on a laptop, use
# localhost and IP addresses, or set DEBUG_ON_PUBLIC_HOST=True if you really mean it.
# DEBUG=False
# The deploy scripts write DJANGO_SETTINGS_MODULE=grama.settings.prod on production servers to
# tell production from qa; the settings themselves no longer depend on it.
# DJANGO_SETTINGS_MODULE=grama.settings.prod

# --- A server without Nginx (the qa server) ------------------------------------
# With DEBUG=False, SERVE_FILES is off by default; on keeps Django serving /media/, /static/,
# /console/ and the website.
# SERVE_FILES=True
# Swagger (/api/docs/) and the schema: open by default in development; with DEBUG=False only for
# console users unless this is True (the qa server, for the client teams).
# API_DOCS_PUBLIC=True
# Django admin (/django-admin/): on for laptops, off on every server with DEBUG=False, where the
# address does not exist (lead's decision of 2026-11-11). Leave it off; set True only if ever needed.
# DJANGO_ADMIN_ENABLED=False
# Its own database: the same DATABASE_URL form as below (tests still use SQLite). Characters
# such as & or @ in the password are written %26 and %40.
# DATABASE_URL=mysql://user:password@localhost:3306/name
# Reached through a domain over https behind the hosting panel's proxy:
# CSRF_TRUSTED_ORIGINS=https://dev.example.in
# TRUST_PROXY_HTTPS=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# --- Required on the server (DEBUG=False) -------------------------------------
# Production refuses to start with this example value, the development key or any key under
# 50 characters. Generate one: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=change-me-to-a-long-random-string
# Key that recognises citizen phones across reinstalls (daily limits, blocks). Empty = SECRET_KEY.
# Before you ever change SECRET_KEY, set this to its current value (deploy/RUNBOOK.md, Rotating secrets).
# PHONE_HASH_KEY=
ALLOWED_HOSTS=gramaconnect.example.in,www.gramaconnect.example.in
CSRF_TRUSTED_ORIGINS=https://gramaconnect.example.in,https://www.gramaconnect.example.in

# One URL picks the database. MySQL gets utf8mb4 automatically; create the
# database with: CREATE DATABASE grama CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql://grama:password@127.0.0.1:3306/grama
# DATABASE_URL=postgres://grama:password@127.0.0.1:5432/grama

# Uploaded photos and collected static files. On the qa server: the backend's media/ and staticfiles/.
MEDIA_ROOT=/var/media
STATIC_ROOT=/srv/gramaconnect/static

# --- Logins (docs/authorization.md) ----------------------------------------------
# Username + password. Admins set or generate temporary passwords; nothing is emailed.
# Lockout: this many failed logins for one username from one IP lock it for the minutes below.
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# And this many failed logins for one username within the window, from any IPs, lock it from every IP
# for LOGIN_LOCKOUT_MINUTES (0 turns this ceiling off).
# LOGIN_MAX_FAILURES_PER_USERNAME=20
# LOGIN_USERNAME_WINDOW_MINUTES=60
# And this many failed logins from one IP within the window, for any usernames, block that IP (0 = off,
# the default). Turn it on only once the server sees real visitor addresses (BVTGC-39), and start high.
# LOGIN_IP_MAX_FAILURES=0
# The proxies whose X-Real-IP is believed (TRUST_X_REAL_IP, on with DEBUG=False). Default: this machine
# only, which fits nginx in front of the app on the same server. Add a proxy on another machine, a load
# balancer or a Docker network here, or every visitor counts as that proxy's address (BE-SEC-212).
# TRUSTED_PROXIES=127.0.0.1,::1
# LOGIN_IP_WINDOW_MINUTES=60
# "Change password": this many wrong current passwords within the window end every session of the user.
# PASSWORD_CHANGE_MAX_FAILURES=5
# PASSWORD_CHANGE_WINDOW_MINUTES=15
# Web console session: ends after this many idle minutes.
# CONSOLE_SESSION_IDLE_MINUTES=30
# Local http only: the session and CSRF cookies are Secure everywhere else.
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# --- Optional ---------------------------------------------------------------
# DB_CONN_MAX_AGE=60
# MySQL and MariaDB only: the strictness rules every connection uses (audit BE-DB-010). The default
# refuses bad data and unclear GROUP BY instead of quietly accepting them. To go back to the old,
# looser mode on a server: DB_SQL_MODE=STRICT_TRANS_TABLES, then restart. Empty: the server's default.
# DB_SQL_MODE=TRADITIONAL,ONLY_FULL_GROUP_BY
# Production only (DEBUG=False). One year by default; subdomains and preload off until the domain is known.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# SECURE_SSL_REDIRECT=False
# LOG_LEVEL=INFO
# Q_WORKERS=2
# Seconds between background-job queue checks while idle (database queries).
# Q_POLL=1.0
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=30
# Days an app login lasts at most, however often it is renewed; then the app asks for the login again.
# 0 = no limit (BVTGC-73).
# JWT_ABSOLUTE_DAYS=90
# Seconds after a refresh in which the same refresh token, sent again because the answer was lost on a
# weak network, still gets a new pair while its replacement is unused. 0 = off (BVTGC-93).
# JWT_REFRESH_GRACE_SECONDS=60
# App update prompts in GET /app-config/ (BVTGC-90): versions such as 1.0.0+24; the app compares the
# build number after the +. Empty = no prompt. LATEST: "Update available" (with Later). MIN: a blocking
# "Please update the app"; raise it only after the new APK is on the website.
# APP_LATEST_VERSION=1.0.0+24
# APP_MIN_VERSION=

# Development: add your PC's LAN address to test the app on a real phone.
# ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.1.20

# Built website and console (run `npm run build` in BVTGramaConnect). Defaults:
# WEB_PUBLIC_DIR=../BVTGramaConnect/dist
# WEB_ADMIN_DIR=../BVTGramaConnect/dist/console

# Play Store link in GET /api/v1/public/site-config/; empty until the app is live.
# The website keeps its own office details and download links.
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=...

# --- Sharing (apps.share, contract section 20) --------------------------------
# The public https address shared links are built from, with the final slash. Empty here:
# posts carry share_url null and the app shares the store link. qa: https://dev.gramaconnect.com/
# PUBLIC_BASE_URL=
# Android App Links: the package and the signing keys' SHA-256 fingerprints, comma separated.
# Play Integrity (CITIZEN_INTEGRITY_REQUIRED=True) also accepts only an app signed with one of
# these keys: once the app is on Google Play, add Play's app-signing key (Play Console, App
# integrity), or every citizen registration is refused.
# ANDROID_PACKAGE=com.bvt.app
# ANDROID_CERT_SHA256=27:16:13:C6:5C:CD:BE:3A:45:97:E0:54:4E:CD:09:CA:44:91:E0:CB:07:63:B3:5E:6E:D0:42:89:D5:8A:89:79
# SHARE_PAGE_MAX_AGE=300

# --- Platform rules (CLAUDE.md) ---------------------------------------------
# ADMIN_POSTS_AUTO_PUBLISH=True
# REVIEW_FIRST_DECISION_WINS=True
# REVIEW_ESCALATION_HOURS=24
# Overdue posts escalated per run of the escalation job, oldest first; the rest wait for the next run.
# ESCALATION_BATCH_SIZE=200
# The Super Admin may post (owner decision of 2026-11-04). False takes "New post" away again.
# SUPER_ADMIN_CAN_POST=True
# Most active Super Admins at once; a Super Admin may make another one. 0 means no limit.
# MAX_SUPER_ADMINS=5

# --- Geography ---------------------------------------------------------------
# Seconds phones and browsers may reuse the public district, mandal and village lists.
# GEO_PUBLIC_MAX_AGE=600

# --- Important numbers (apps.contacts) ---------------------------------------
# Active numbers allowed in one area.
# CONTACTS_MAX_PER_AREA=200
# Seconds citizens' phones may reuse the Contacts tab before asking again.
# CONTACTS_PUBLIC_MAX_AGE=300
# Numbers nobody confirmed for this many days show "needs re-check" to officials.
# CONTACTS_VERIFY_DAYS=180
# A 10-digit mobile is published only with the consent tick (decision C2).
# CONTACTS_REQUIRE_MOBILE_CONSENT=True
# CSV import limits.
# CONTACTS_IMPORT_MAX_BYTES=2097152
# GEO_IMPORT_MAX_BYTES=20971520
# CONTACTS_IMPORT_MAX_ROWS=5000

# --- Push notifications (apps.notifications, contract section 7) ------------
# Without FCM_CREDENTIALS_FILE nothing is sent. The key is a secret: never in git or the site folder.
# FCM_CREDENTIALS_FILE=
# FCM_PROJECT_ID=
# "qa_" on the qa server, empty in production (one Firebase project for both).
# FCM_TOPIC_PREFIX=
# Drop a push not delivered within a day.
# PUSH_TTL_SECONDS=86400
# Every post goes out at high priority (approved 2026-11-04). False: only urgent posts at high.
# PUSH_ALL_POSTS_HIGH_PRIORITY=True
# A post's push job starts no new area topic after this many seconds and queues the rest as a
# new job, so the worker never stops it halfway and re-runs it (duplicate pushes). Below 120.
# PUSH_TOPICS_JOB_SECONDS=60

# --- Citizen posts (apps.citizens, contract section 15) --------------------
# Citizens never sign in: a phone gets a posting token, after Google Play Integrity confirms the
# genuine app while this is on. Off by default everywhere until the app is on Google Play (owner's
# decision of 2026-11-04): website installs cannot pass the check. On that day set it True on
# production (and add Play's app-signing key to ANDROID_CERT_SHA256); until then `manage.py check`
# warns on servers (citizens.W001).
# CITIZEN_INTEGRITY_REQUIRED=True
# The Android package name, and a service account allowed to call the Play Integrity API
# (defaults to FCM_CREDENTIALS_FILE).
# PLAY_INTEGRITY_PACKAGE=com.bvt.app
# PLAY_INTEGRITY_CREDENTIALS_FILE=
# CITIZEN_POSTS_ENABLED=True
# Posts per phone a day: 5. This is only the starting value; the Super Admin changes it in the
# console (Settings), which overrides it. 0 is no limit.
# CITIZEN_POSTS_PER_DAY=5
# A citizen's post is for the phone's village only (owner's decision of 2026-11-19); there is no
# setting for it. CITIZEN_MAX_TARGETS and CITIZEN_CAN_TARGET_STATE are gone and ignored if left in .env.
# New phones per IP address a day: 0 (the default) is no limit. Photos per citizen post follow
# MAX_PHOTOS_PER_POST below, as for officials.
# CITIZEN_REGISTRATIONS_PER_IP_PER_DAY=0

# --- Services and service requests (apps.service_requests, contract section 16) ---
# Requests one citizen phone may send in 24 hours; 0 is no limit.
# SERVICE_REQUESTS_PER_DAY=10
# Seconds phones may reuse the public services list.
# SERVICES_PUBLIC_MAX_AGE=300
# Service logos the Super Admin uploads: upload size, smallest side, stored size.
# SERVICE_LOGO_MAX_UPLOAD_MB=2
# SERVICE_LOGO_MIN_PX=64
# SERVICE_LOGO_PX=256

# --- Photos and videos in posts (apps.posts.media, contract sections 5 and 15) ---
# Lead's decisions of 2026-11-13 and 2026-11-14, for everyone who posts, citizens included: up to
# this many photos, or one video, never both. Each photo up to 10 MB; the video up to 60 MB and
# 60 seconds (0 would be any length). The console and the app check the same numbers: change
# them together. Banner videos have their own limits below.
# MAX_PHOTOS_PER_POST=3
# MAX_IMAGE_UPLOAD_MB=10
# MAX_VIDEO_UPLOAD_MB=60
# VIDEO_MAX_SECONDS=60

# --- Checking uploads (apps.posts.media, audit BE-PERF-003) -----------------
# Each ffprobe/ffmpeg step stops after its limit (415); all files of one request share the
# budget (400, nothing stored). Keep the budget below Gunicorn's --timeout (GUNICORN_TIMEOUT, 120).
# VIDEO_PROBE_TIMEOUT_S=15
# VIDEO_POSTER_TIMEOUT_S=20
# VIDEO_STRIP_TIMEOUT_S=45
# MEDIA_PROCESSING_BUDGET_S=90
# Gunicorn's --timeout on the hosting panel (deploy/qa/BVT-start.sh), like WEB_WORKERS:
# GUNICORN_TIMEOUT=120

# --- Home banner ads (apps.ads, contract section 17) ------------------------
# ADS_MAX_UPLOAD_MB=5
# ADS_MIN_WIDTH_PX=800
# ADS_IMAGE_MAX_PX=1600
# Video banners: any length, at most 60 MB (owner decision; unlike post videos, no 60 s limit). The app and the console have the
# size too, and Nginx allows 70 MB for /api/v1/admin/ads/: change them together. 0 s = any length.
# ADS_VIDEO_MAX_MB=60
# ADS_VIDEO_MAX_SECONDS=0
# ADS_PUBLIC_LIMIT=10
# ADS_PUBLIC_MAX_AGE=300

# --- Post translation (apps.posts.translation, contract section 1 "Language") ---
# Published posts are machine-translated into the other language (Telugu <-> English) by the
# worker. off (the default): nothing is sent anywhere. google or bhashini, with its keys.
# After switching it on: python manage.py translate_published_posts --since 2026-10-01
# TRANSLATION_PROVIDER=off
# GOOGLE_TRANSLATE_KEY=
# BHASHINI_USER_ID=
# BHASHINI_API_KEY=
# BHASHINI_PIPELINE_ID=
# TRANSLATION_TIMEOUT_S=20

# Telugu name suggestions: the admins' Telugu name boxes fill from the English name through
# GET /api/v1/admin/transliterate/ ("Ravi Kumar" -> "రవి కుమార్"). Only this server calls the
# provider. off: no suggestions, admins type Telugu themselves (restart after changing).
# TRANSLITERATION_PROVIDER=google_input_tools
# TRANSLITERATION_TIMEOUT_S=4
# TRANSLITERATION_CACHE_S=2592000
# TRANSLITERATION_RATE=60/min

# --- Audit log screens (contract section 8) ---------------------------------
# Every entry is listed, however old (decision of 2026-11-20); dates or a month narrow the list.
# An export matching more than AUDIT_EXPORT_MAX_ROWS entries answers 400 asking for a shorter date range.
# AUDIT_EXPORT_MAX_ROWS=50000

# --- Background jobs ---------------------------------------------------------
# How often the escalation job runs, in minutes.
# ESCALATION_CHECK_MINUTES=15
# Daily housekeeping deletes failed background jobs older than this many days.
# HOUSEKEEPING_KEEP_DAYS=30
# It also deletes officials' read notifications older than this many days (0 keeps them all).
# NOTIFICATION_KEEP_DAYS=90

# --- Audit log ---------------------------------------------------------------
# Longest text kept in an audit entry; longer text is cut with "…". Comments and notes are
# already limited to 500 characters by the API, so they are never cut.
# AUDIT_TEXT_MAX_CHARS=2000

# --- Email (citizen wallet codes and notices, BVTGC-122) -----------------------
# Laptops print emails in the terminal (the console backend while DEBUG is on). Servers send them
# through the client's email service (BVTGC-143); manage.py check warns (citizens.W002) until set.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=Grama Connect <no-reply@gramaconnect.com>

# --- Citizen wallet (docs/api-contract.md, section 21) --------------------------
# Off until launch: every citizen wallet endpoint answers 404. These are starting values only: the Super
# Admin changes the switch, the pilot mandals and the reward rules in the console (Settings, BVTGC-129),
# and a saved value wins over .env.
# WALLET_ENABLED=False
# WALLET_PILOT_MANDALS=12,15            (mandal ids; empty means everywhere)
# REFERRAL_REWARD_POINTS=50
# WELCOME_BONUS_POINTS=20
# REFERRAL_HOLD_DAYS=7
# REFERRAL_ACTIVE_DAYS=2
# REFERRALS_PER_MONTH=30                (0 is no limit)
# WELCOME_BONUSES_PER_PHONE=3
# CITIZEN_CONSENT_VERSION=2026-11-25    (change it with the privacy policy and terms)
# CITIZEN_PASSWORD_MIN_LENGTH=8
# CITIZEN_DELETED_KEEP_DAYS=365       (days a deleted account's number and email fingerprints stop a second
#                                      welcome bonus; housekeeping then clears them; 0 keeps them)
# THROTTLE_CACHE_MAX_ENTRIES=200000   (rows of the shared "throttle" cache table before Django deletes a third;
#                                      it holds the forgotten-password and deletion code decoys of unknown logins
#                                      for a day, BVTGC-152; servers only)
