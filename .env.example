# Copy to .env and fill in. Real environment variables win over this file.
# Local development needs no .env at all: the defaults run on SQLite.

# All settings are in grama/settings.py. DEBUG picks the mode:
#   True or unset: development (SQLite, Django serves the web parts, cookies over plain http).
#   False: production (secure cookies, HSTS, key check; the "Required on the server" lines below).
# Every server, qa included, runs with DEBUG=False.
# DEBUG=False
# The deploy scripts write DJANGO_SETTINGS_MODULE=grama.settings.prod on production servers to
# tell production from qa; the settings themselves no longer depend on it.
# DJANGO_SETTINGS_MODULE=grama.settings.prod

# --- A server without Nginx (the qa server) ------------------------------------
# With DEBUG=False, SERVE_FILES is off by default; on keeps Django serving /media/, /static/,
# /console/ and the website.
# SERVE_FILES=True
# Swagger (/api/docs/) and the schema: open by default in development; with DEBUG=False only for
# console users unless this is True (the qa server, for the client teams).
# API_DOCS_PUBLIC=True
# Its own database: the same DATABASE_URL form as below (tests still use SQLite). Characters
# such as & or @ in the password are written %26 and %40.
# DATABASE_URL=mysql://user:password@localhost:3306/name
# Reached through a domain over https behind the hosting panel's proxy:
# CSRF_TRUSTED_ORIGINS=https://dev.example.in
# TRUST_PROXY_HTTPS=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# --- Required on the server (DEBUG=False) -------------------------------------
# Production refuses to start with this example value, the development key or any key under
# 50 characters. Generate one: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=gramaconnect.example.in,www.gramaconnect.example.in
CSRF_TRUSTED_ORIGINS=https://gramaconnect.example.in,https://www.gramaconnect.example.in

# One URL picks the database. MySQL gets utf8mb4 automatically; create the
# database with: CREATE DATABASE grama CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql://grama:password@127.0.0.1:3306/grama
# DATABASE_URL=postgres://grama:password@127.0.0.1:5432/grama

# Uploaded photos and collected static files. On the qa server: the backend's media/ and staticfiles/.
MEDIA_ROOT=/var/media
STATIC_ROOT=/srv/gramaconnect/static

# --- Logins (docs/authorization.md) ----------------------------------------------
# Username + password. Admins set or generate temporary passwords; nothing is emailed.
# Lockout: this many failed logins for one username from one IP lock it for the minutes below.
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# IP-wide cap: this many failed logins from one IP, any usernames, within the window block that IP (0 = off).
# LOGIN_IP_MAX_FAILURES=50
# LOGIN_IP_WINDOW_MINUTES=60
# Login throttle: app and console logins from one IP, successful or not (429 throttled over it).
# LOGIN_THROTTLE_RATE=30/hour
# "Change password": this many wrong current passwords within the window end every session of the user.
# PASSWORD_CHANGE_MAX_FAILURES=5
# PASSWORD_CHANGE_WINDOW_MINUTES=15
# Web console session: ends after this many idle minutes.
# CONSOLE_SESSION_IDLE_MINUTES=30
# Local http only: the session and CSRF cookies are Secure everywhere else.
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# --- Optional ---------------------------------------------------------------
# DB_CONN_MAX_AGE=60
# Production only (DEBUG=False). One year by default; subdomains and preload off until the domain is known.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# SECURE_SSL_REDIRECT=False
# LOG_LEVEL=INFO
# Q_WORKERS=2
# Seconds between background-job queue checks while idle (database queries).
# Q_POLL=1.0
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=30

# Development: add your PC's LAN address to test the app on a real phone.
# ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.1.20

# Built website and console (run `npm run build` in BVTGramaConnect). Defaults:
# WEB_PUBLIC_DIR=../BVTGramaConnect/dist
# WEB_ADMIN_DIR=../BVTGramaConnect/dist/console

# Play Store link in GET /api/v1/public/site-config/; empty until the app is live.
# The website keeps its own office details and download links.
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=...

# --- Sharing (apps.share, contract section 20) --------------------------------
# The public https address shared links are built from, with the final slash. Empty here:
# posts carry share_url null and the app shares the store link. qa: https://dev.gramaconnect.com/
# PUBLIC_BASE_URL=
# Android App Links: the package and the signing keys' SHA-256 fingerprints, comma separated.
# ANDROID_PACKAGE=com.bvt.app
# ANDROID_CERT_SHA256=27:16:13:C6:5C:CD:BE:3A:45:97:E0:54:4E:CD:09:CA:44:91:E0:CB:07:63:B3:5E:6E:D0:42:89:D5:8A:89:79
# SHARE_PAGE_MAX_AGE=300

# --- Platform rules (CLAUDE.md) ---------------------------------------------
# ADMIN_POSTS_AUTO_PUBLISH=True
# REVIEW_FIRST_DECISION_WINS=True
# REVIEW_ESCALATION_HOURS=24
# The Super Admin may post (owner decision of 2026-11-04). False takes "New post" away again.
# SUPER_ADMIN_CAN_POST=True
# Most active Super Admins at once; a Super Admin may make another one. 0 means no limit.
# MAX_SUPER_ADMINS=5

# --- Geography ---------------------------------------------------------------
# Seconds phones and browsers may reuse the public district, mandal and village lists.
# GEO_PUBLIC_MAX_AGE=600

# --- Important numbers (apps.contacts) ---------------------------------------
# Active numbers allowed in one area.
# CONTACTS_MAX_PER_AREA=200
# Seconds citizens' phones may reuse the Contacts tab before asking again.
# CONTACTS_PUBLIC_MAX_AGE=300
# Numbers nobody confirmed for this many days show "needs re-check" to officials.
# CONTACTS_VERIFY_DAYS=180
# A 10-digit mobile is published only with the consent tick (decision C2).
# CONTACTS_REQUIRE_MOBILE_CONSENT=True
# CSV import limits.
# CONTACTS_IMPORT_MAX_BYTES=2097152
# CONTACTS_IMPORT_MAX_ROWS=5000

# --- Push notifications (apps.notifications, contract section 7) ------------
# Without FCM_CREDENTIALS_FILE nothing is sent. The key is a secret: never in git or the site folder.
# FCM_CREDENTIALS_FILE=
# FCM_PROJECT_ID=
# "qa_" on the qa server, empty in production (one Firebase project for both).
# FCM_TOPIC_PREFIX=
# Drop a push not delivered within a day.
# PUSH_TTL_SECONDS=86400
# Every post goes out at high priority (approved 2026-11-04). False: only urgent posts at high.
# PUSH_ALL_POSTS_HIGH_PRIORITY=True

# --- Citizen posts (apps.citizens, contract section 15) --------------------
# Citizens never sign in: a phone gets a posting token after Google Play Integrity
# confirms the genuine app. On by default with DEBUG=False, off in development. The qa server
# sets it False for debug builds. Never turn it off in production.
# CITIZEN_INTEGRITY_REQUIRED=False
# The Android package name, and a service account allowed to call the Play Integrity API
# (defaults to FCM_CREDENTIALS_FILE).
# PLAY_INTEGRITY_PACKAGE=com.bvt.app
# PLAY_INTEGRITY_CREDENTIALS_FILE=
# CITIZEN_POSTS_ENABLED=True
# Posts per phone a day: 5. This is only the starting value; the Super Admin changes it in the
# console (Settings), which overrides it. 0 is no limit.
# CITIZEN_POSTS_PER_DAY=5
# Who a citizen's post may be for (owner decision of 2026-10-28: like officials). Areas per post
# (0: POST_MAX_TARGETS, 200), and whether Everyone is allowed. Narrow them here if needed.
# CITIZEN_MAX_TARGETS=0
# CITIZEN_CAN_TARGET_STATE=True
# Photos per post, new phones per IP address a day: 0 (the default) is no limit.
# CITIZEN_MAX_PHOTOS=0
# CITIZEN_REGISTRATIONS_PER_IP_PER_DAY=0

# --- Services and service requests (apps.service_requests, contract section 16) ---
# Requests one citizen phone may send in 24 hours; 0 is no limit.
# SERVICE_REQUESTS_PER_DAY=10
# Seconds phones may reuse the public services list.
# SERVICES_PUBLIC_MAX_AGE=300
# Service logos the Super Admin uploads: upload size, smallest side, stored size.
# SERVICE_LOGO_MAX_UPLOAD_MB=2
# SERVICE_LOGO_MIN_PX=64
# SERVICE_LOGO_PX=256

# --- Home banner ads (apps.ads, contract section 17) ------------------------
# ADS_MAX_UPLOAD_MB=5
# ADS_MIN_WIDTH_PX=800
# ADS_IMAGE_MAX_PX=1600
# Video banners: any length, at most 60 MB (owner decision). The app and the console have the
# size too, and Nginx allows 70 MB for /api/v1/admin/ads/: change them together. 0 s = any length.
# ADS_VIDEO_MAX_MB=60
# ADS_VIDEO_MAX_SECONDS=0
# ADS_PUBLIC_LIMIT=10
# ADS_PUBLIC_MAX_AGE=300

# --- Post translation (apps.posts.translation, contract section 1 "Language") ---
# Published posts are machine-translated into the other language (Telugu <-> English) by the
# worker. off (the default): nothing is sent anywhere. google or bhashini, with its keys.
# After switching it on: python manage.py translate_published_posts --since 2026-10-01
# TRANSLATION_PROVIDER=off
# GOOGLE_TRANSLATE_KEY=
# BHASHINI_USER_ID=
# BHASHINI_API_KEY=
# BHASHINI_PIPELINE_ID=
# TRANSLATION_TIMEOUT_S=20

# Telugu name suggestions: the admins' Telugu name boxes fill from the English name through
# GET /api/v1/admin/transliterate/ ("Ravi Kumar" -> "రవి కుమార్"). Only this server calls the
# provider. off: no suggestions, admins type Telugu themselves (restart after changing).
# TRANSLITERATION_PROVIDER=google_input_tools
# TRANSLITERATION_TIMEOUT_S=4
# TRANSLITERATION_CACHE_S=2592000
# TRANSLITERATION_RATE=60/min

# --- Background jobs ---------------------------------------------------------
# How often the escalation job runs, in minutes.
# ESCALATION_CHECK_MINUTES=15
# Daily housekeeping deletes failed background jobs older than this many days.
# HOUSEKEEPING_KEEP_DAYS=30
