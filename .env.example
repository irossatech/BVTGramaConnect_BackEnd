# Copy to .env and fill in. Real environment variables win over this file.
# Local development needs no .env at all: the defaults run on SQLite.

# Which settings module manage.py uses. dev is the default; the server uses prod.
# Set this in the shell or the systemd unit, not only here.
# DJANGO_SETTINGS_MODULE=grama.settings.prod

# --- Required on the server (grama.settings.prod) ---------------------------
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=gramaconnect.example.in,www.gramaconnect.example.in
CSRF_TRUSTED_ORIGINS=https://gramaconnect.example.in,https://www.gramaconnect.example.in

# One URL picks the database. MySQL gets utf8mb4 automatically; create the
# database with: CREATE DATABASE grama CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql://grama:password@127.0.0.1:3306/grama
# DATABASE_URL=postgres://grama:password@127.0.0.1:5432/grama

MEDIA_ROOT=/var/media
STATIC_ROOT=/srv/gramaconnect/static

# --- Logins (docs/authorization.md) ----------------------------------------------
# Username + password. Admins set or generate temporary passwords; nothing is emailed.
# Lockout: this many failed logins for one username from one IP lock it for the minutes below.
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# Web console session: ends after this many idle minutes.
# CONSOLE_SESSION_IDLE_MINUTES=30
# Local http only: the session and CSRF cookies are Secure everywhere else.
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# --- Optional ---------------------------------------------------------------
# DB_CONN_MAX_AGE=60
# SECURE_HSTS_SECONDS=31536000
# SECURE_SSL_REDIRECT=False
# LOG_LEVEL=INFO
# Q_WORKERS=2
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=30

# Development: add your PC's LAN address to test the app on a real phone.
# ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.1.20

# Built website and console (run `npm run build` in BVTGramaConnect). Defaults:
# WEB_PUBLIC_DIR=../BVTGramaConnect/dist
# WEB_ADMIN_DIR=../BVTGramaConnect/dist/console

# Public website contact details and store links (GET /api/v1/public/site-config/).
# Defaults are the prototype's values; store links stay empty until the apps are live.
# SITE_PHONE=+91 863 223 4567
# SITE_EMAIL=help@bvtgramaconnect.in
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=...
# APP_STORE_URL=https://apps.apple.com/app/...

# --- Platform rules (CLAUDE.md) ---------------------------------------------
# ADMIN_POSTS_AUTO_PUBLISH=True
# REVIEW_FIRST_DECISION_WINS=True
# REVIEW_ESCALATION_HOURS=24
# SUPER_ADMIN_CAN_POST=False
