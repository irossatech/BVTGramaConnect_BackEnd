# Settings for python -m grama.perftest (load, stress, spike and soak tests against STAGING only).
# Copy to .env.test, which git ignores, and fill in. Never put production or qa here: the runner refuses
# them (deploy/loadtest/profiles.json, refused_hosts). Real values never go in a committed file.

# The staging server, with https:// and no path.
LOADTEST_BASE_URL=

# A staging official for the logged-in part of the mix (optional). Use a test account made for this.
LOADTEST_OFFICIAL_USERNAME=
LOADTEST_OFFICIAL_PASSWORD=

# Optional: an address on staging answering {"cpu_percent", "memory_mb", "db_connections"} as JSON.
LOADTEST_METRICS_URL=
